<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No INTERNET. MANAGE_EXTERNAL_STORAGE grants direct filesystem access
         to the export folder, avoiding a full 2GB copy into app-private storage.
         Requires user grant via Settings on Android 11+. On Android 10 and below
         the equivalent is READ_EXTERNAL_STORAGE, requested at runtime. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.IGArchive">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.IGArchive">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Serves the staged clipboard copy as content:// so another app can paste real
             media. Only the cache/clipboard directory is exposed, never the export folder. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
