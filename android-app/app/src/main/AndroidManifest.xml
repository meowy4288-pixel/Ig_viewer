<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No INTERNET and no storage permissions.
         Archives are chosen through the Storage Access Framework, which grants
         access per file/folder at pick time, so no manifest permission is needed. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.IGArchive">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.IGArchive">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
